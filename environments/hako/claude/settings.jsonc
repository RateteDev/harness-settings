// hako の VM で動く Claude Code の ~/.claude/settings.json の元になる設定。
// setup.sh がコメントを除いた JSON に変換して置く。設定の理由はこのファイルにだけ書く。
// 権限の確認を省く設定は、同じディレクトリの run が起動のときに渡すため、ここには書かない。
{
  // Claude Code 本体がコミットと PR に帰属表記を付けるよう誘導するのを止める。
  "attribution": false,

  // システムプロンプトにある commit と PR の手順を外す。コミット規約スキルと重なり、食い違うと規約を優先させたいため。
  "includeGitInstructions": false,

  // claude.ai に置いたスキルとプラグインを取り込まず、スキルはこのリポジトリのものだけにする。
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,

  // hako は入口（turn・worker・interactive）を環境変数 HAKO_MODE で伝え、値の意味は hako_instructions.md に書いている。
  // このセッションの値と、入口ごとのItoguchiの事情は modes/ に書き、setup.sh が置いたものをセッションの始めに知らせる。
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat \"$HOME/.claude/hako-modes/$HAKO_MODE.md\" 2>/dev/null || true" }
        ]
      }
    ]
  },

  "permissions": {
    // hako の VM では、呼ばれたことをホストの連携サーバーが新しいターンとして届ける。
    // ターンの中で待つと、プロセスが終わらずVMを止められず、同じ呼びかけに2回答えることにもなる。
    // 権限の確認を省く設定でも deny は効き、道具の一覧から消えることを確かめてある。
    "deny": ["mcp__itoguchi__wait_for_events"]
  }
}
