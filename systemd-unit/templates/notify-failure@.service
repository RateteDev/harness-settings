# Instantiated by OnFailure=notify-failure@%n.service, so %i carries the name of
# the unit that failed. One template serves every unit on the host; without it
# each unit would carry its own copy of the same reporting logic.
#
# What the report is sent to is the host's business, not this skill's: fill in
# {notifier} with an executable that takes the failed unit's name as its only
# argument and reports it wherever that host reports things. Everything else it
# needs, it reads back out of systemd.
#
# This is the host's unit rather than any repository's, so no `just` recipe
# registers it. A template unit cannot be enabled without an instance either:
# linking it and reloading is the whole installation.

[Unit]
Description=Report a failed user unit

[Service]
Type=oneshot

# Written out rather than inherited: a unit reporting a failure is the last
# place an undeclared dependency should be allowed to surface.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStart={notifier} %i
