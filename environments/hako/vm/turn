#!/bin/bash
# VMの中で、ハーネスの非対話の1ターンを動かす。ホストの hako.ts が sbx exec で呼ぶ。
#   turn <ハーネス> <プロンプト>
# 同じディレクトリの <ハーネス>/setup.sh で設定を反映してから、<ハーネス>/run にプロンプトを渡す。
# 記録は ~/.hako/state/<ハーネス>/ に残し、失敗したときは末尾を標準エラーへ出す。
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
harness="${1:?ハーネスを指定してください}"
prompt="${2:?プロンプトを指定してください}"
[ -x "$here/$harness/run" ] || { echo "知らないハーネスです: $harness" >&2; exit 2; }

export HAKO_STATE="$HOME/.hako/state/$harness"
mkdir -p "$HAKO_STATE" "$HOME/workspace"

if ! "$here/$harness/setup.sh" > "$HAKO_STATE/setup.log" 2>&1; then
  echo "設定を反映できませんでした:" >&2
  tail -n 5 "$HAKO_STATE/setup.log" >&2
  exit 1
fi

cd "$HOME/workspace" || exit 1
echo "--- turn $(date -Is)" >> "$HAKO_STATE/session.log"
"$here/$harness/run" "$prompt" >> "$HAKO_STATE/session.log" 2>&1
code=$?
if [ "$code" -ne 0 ]; then
  echo "ハーネスが終了コード $code で終わりました:" >&2
  tail -n 5 "$HAKO_STATE/session.log" | cut -c1-500 >&2
fi
exit "$code"
