# ─── CI ───

# Run local CI (mirrors remote CI pipeline).
#
# The `set shell` at the top of this file does NOT reach a shebang recipe: just
# writes it to a temp file and only reads its final exit status. Without `-e`
# here the serial checks below run, fail, and are then overwritten by the exit
# status of the parallel half, leaving the gate green.
#
# A bare `wait` always exits 0 for the same reason, so each background job is
# awaited by PID instead.
[doc('Run local CI (mirrors remote CI pipeline)')]
[group('CI')]
ci-local:
    #!/usr/bin/env bash
    set -euo pipefail
    just repo-checks
    just _check-hooks-configured
    pids=()
    just back-ci & pids+=($!)
    just front-ci & pids+=($!)
    failed=0
    for pid in "${pids[@]}"; do
        wait "$pid" || failed=1
    done
    exit $failed

# Run repository-wide checks that do not belong to one application
[group('CI')]
repo-checks:
    @echo "TODO: implement repo-checks"

[private]
_check-hooks-configured:
    @test "$(git config --get core.hooksPath)" = ".githooks" || { echo "core.hooksPath is not '.githooks' — run 'just setup'"; exit 1; }
