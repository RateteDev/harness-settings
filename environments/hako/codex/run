#!/bin/bash
# turn が呼ぶ。Codex を非対話で1ターン動かし、2回目からは直近の会話を続ける。
#   run <プロンプト>
# 認証は、ホストで sbx secret set openai --oauth を済ませておく（追加部品 codex-mixin が sbx の中継に任せる）。
set -euo pipefail
started="${HAKO_STATE:?}/started"
# 作業場所は Git のリポジトリとは限らない。
if [ -f "$started" ]; then
  exec codex exec --skip-git-repo-check resume --last -- "$1"
fi
codex exec --skip-git-repo-check -- "$1"
touch "$started"
