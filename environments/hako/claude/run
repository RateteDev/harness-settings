#!/bin/bash
# turn が呼ぶ。Claude Code を非対話で1ターン動かし、2回目からは同じ会話を続ける。
#   run <プロンプト>
# 認証は、sbx に登録した鍵（環境変数 CLAUDE_CODE_OAUTH_TOKEN の代わりの値を、sbx の中継が本物に差し替える）で済んでいる。
set -euo pipefail
id_file="${HAKO_STATE:?}/session-id"
# VMの中で権限の確認を待つと、非対話では誰も答えられず止まる。
args=(-p --output-format stream-json --verbose --permission-mode bypassPermissions)
# プロンプトが「-」で始まっても（箇条書きなど）、claude のオプションと読まれないよう -- で区切る。
if [ -f "$id_file" ]; then
  exec claude "${args[@]}" --resume "$(cat "$id_file")" -- "$1"
fi
id="$(cat /proc/sys/kernel/random/uuid)"
claude "${args[@]}" --session-id "$id" -- "$1"
# 会話を始められたときだけIDを残し、失敗したときは次のターンでもう一度始める。
echo "$id" > "$id_file"
